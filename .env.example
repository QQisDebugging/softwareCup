SOFTWARECUP_DB_URL=jdbc:postgresql://localhost:5432/softwarecup
SOFTWARECUP_DB_USER=softwarecup
SOFTWARECUP_DB_PASSWORD=softwarecup
SOFTWARECUP_AGENT_RESOURCE_BASE_URL=http://localhost:9001
SOFTWARECUP_AGENT_PROVIDER=xfyun_spark
RESOURCE_AGENT_PROVIDER=xfyun_spark
RESOURCE_AGENT_SEED_PATHS=data/courses/java-web-software-engineering.json;reference/题目说明.txt
RESOURCE_AGENT_RETRIEVAL_TOP_K=6

# 讯飞星火正式接入。真实密钥只放本地 .env 或系统环境变量，禁止提交。
XFYUN_APP_ID=
XFYUN_API_PASSWORD=
XFYUN_API_KEY=
XFYUN_API_SECRET=
XFYUN_MODEL=generalv3.5
XFYUN_ENDPOINT=https://spark-api-open.xf-yun.com/v1/chat/completions
XFYUN_CACHE_ENABLED=true
XFYUN_CACHE_DIR=.cache/xfyun-spark
XFYUN_DAILY_CALL_LIMIT=20
